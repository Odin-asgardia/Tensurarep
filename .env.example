# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/slime-rpg

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long
JWT_EXPIRE=7d

# Stripe Configuration (South African Rands)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# PayStack Configuration (Alternative for ZAR payments)
PAYSTACK_SECRET=pk_test_paystack_secret_key

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Game Configuration
GAME_NAME=Reincarnated Saga: Slime Reborn
VIP_PRICE_ZAR=130
VIP_DURATION_DAYS=30
MAX_CHARACTERS_PER_USER=5

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
