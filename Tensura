<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tensei — Reincarnation Chronicle</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600;700&family=Exo+2:ital,wght@0,200;0,400;0,600;0,800;1,300&display=swap');

/* ══════════════════════════ VARIABLES ══════════════════════════ */
:root {
  --bg:        #05080f;
  --deep:      #080c16;
  --panel:     #0d1526;
  --border:    #162040;
  --border2:   #1e2e50;

  --slime:     #29b6f6;
  --slime2:    #4dd0e1;
  --human:     #ffca28;
  --human2:    #ffe082;
  --demon:     #ef5350;
  --demon2:    #ff8a65;
  --angel:     #e1f5fe;
  --angel2:    #b3e5fc;
  --beast:     #66bb6a;
  --beast2:    #a5d6a7;
  --spirit:    #ce93d8;
  --spirit2:   #f3e5f5;
  --dwarf:     #ff8f00;
  --dwarf2:    #ffcc02;

  --accent:    #29b6f6;
  --gold:      #ffd54f;
  --safe:      #66bb6a;
  --danger:    #ef5350;
  --muted:     #37506e;
  --text:      #b0c4de;
  --bright:    #deeeff;
  --magicule:  #ce93d8;
}

*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Exo 2',sans-serif;
  min-height:100vh;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  padding:12px;
  overflow-x:hidden;
}

/* animated grid bg */
body::before{
  content:'';position:fixed;inset:0;z-index:0;
  background-image:
    linear-gradient(rgba(29,112,196,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(29,112,196,0.03) 1px, transparent 1px);
  background-size:40px 40px;
  pointer-events:none;
}
body::after{
  content:'';position:fixed;inset:0;z-index:0;
  background:
    radial-gradient(ellipse 70% 50% at 15% 85%, rgba(41,182,246,0.05) 0%,transparent 60%),
    radial-gradient(ellipse 60% 40% at 85% 15%, rgba(206,147,216,0.05) 0%,transparent 60%);
  pointer-events:none;
}

/* ══════════════════════════ SCREENS ══════════════════════════ */
.screen{display:none;position:relative;z-index:1;width:100%;max-width:720px;margin:0 auto;}
.screen.active{display:block;}

/* ══════════════════════════ CHAR CREATE ══════════════════════════ */
#screen-create{padding:20px 0 40px;}

.cc-header{
  text-align:center;
  padding:24px 20px 20px;
  border:1px solid var(--border);
  background:var(--panel);
  margin-bottom:0;
}
.cc-title{
  font-family:'Noto Serif JP',serif;
  font-size:11px;letter-spacing:6px;
  color:var(--muted);margin-bottom:8px;text-transform:uppercase;
}
.cc-main-title{
  font-family:'Noto Serif JP',serif;
  font-size:26px;font-weight:700;
  color:var(--bright);
  text-shadow:0 0 30px rgba(41,182,246,0.3);
  margin-bottom:4px;
}
.cc-sub{font-size:12px;color:var(--muted);letter-spacing:2px;}

/* Step indicator */
.steps{
  display:flex;border:1px solid var(--border);border-top:none;border-bottom:none;
  background:var(--deep);
}
.step-dot{
  flex:1;padding:10px;text-align:center;
  font-size:9px;letter-spacing:2px;color:var(--muted);
  border-right:1px solid var(--border);transition:all 0.3s;
}
.step-dot:last-child{border-right:none;}
.step-dot.done{color:var(--safe);background:rgba(102,187,106,0.05);}
.step-dot.active{color:var(--accent);background:rgba(41,182,246,0.07);}

/* Section block */
.cc-section{
  border:1px solid var(--border);border-top:none;
  background:var(--panel);padding:20px;
}
.cc-section-title{
  font-size:10px;letter-spacing:4px;color:var(--muted);
  text-transform:uppercase;margin-bottom:14px;
  display:flex;align-items:center;gap:10px;
}
.cc-section-title::after{content:'';flex:1;height:1px;background:var(--border);}

/* Name input */
.name-input-wrap{position:relative;margin-bottom:6px;}
.name-input{
  width:100%;background:var(--deep);border:1px solid var(--border2);
  color:var(--bright);font-family:'Exo 2',sans-serif;font-size:18px;font-weight:600;
  padding:12px 16px;letter-spacing:2px;outline:none;
  transition:border-color 0.2s;
}
.name-input:focus{border-color:var(--accent);}
.name-hint{font-size:10px;color:var(--muted);letter-spacing:1px;}

/* Race grid */
.race-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;
}
.race-card{
  background:var(--deep);border:1px solid var(--border);
  padding:14px 12px;cursor:pointer;
  transition:all 0.2s;position:relative;overflow:hidden;
}
.race-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--rc,var(--accent));opacity:0;transition:opacity 0.2s;
}
.race-card:hover{border-color:var(--border2);}
.race-card.selected{border-color:var(--rc,var(--accent));}
.race-card.selected::before{opacity:1;}
.race-icon{font-size:22px;margin-bottom:6px;}
.race-name{
  font-size:12px;font-weight:800;letter-spacing:2px;
  color:var(--bright);margin-bottom:3px;
}
.race-desc{font-size:10px;color:var(--muted);line-height:1.5;}
.race-bonus{
  margin-top:8px;font-size:9px;letter-spacing:1px;
  color:var(--rc,var(--accent));
}
.race-restricted{
  margin-top:4px;font-size:9px;color:var(--danger);opacity:0.7;
}

/* Skill path grid */
.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.path-card{
  background:var(--deep);border:1px solid var(--border);
  padding:14px;cursor:pointer;transition:all 0.2s;
  position:relative;overflow:hidden;
}
.path-card::after{
  content:'';position:absolute;bottom:0;right:0;
  width:60px;height:60px;
  background:radial-gradient(circle, var(--pc,var(--accent)) 0%, transparent 70%);
  opacity:0.05;transition:opacity 0.2s;
}
.path-card:hover::after,.path-card.selected::after{opacity:0.12;}
.path-card.locked{opacity:0.3;cursor:not-allowed;}
.path-card.locked::before{
  content:'RESTRICTED';position:absolute;top:8px;right:8px;
  font-size:8px;letter-spacing:1px;color:var(--danger);
  border:1px solid var(--danger);padding:1px 5px;
}
.path-card.selected{border-color:var(--pc,var(--accent));}
.path-name{
  font-size:13px;font-weight:700;letter-spacing:1px;
  color:var(--bright);margin-bottom:4px;
}
.path-type{
  font-size:9px;letter-spacing:2px;
  color:var(--pc,var(--accent));margin-bottom:8px;
}
.path-skills{font-size:10px;color:var(--muted);line-height:1.6;}

/* Unique skill preview */
.unique-skill-box{
  background:var(--deep);border:1px solid var(--border2);
  padding:14px;margin-top:8px;
}
.us-title{font-size:9px;letter-spacing:3px;color:var(--magicule);margin-bottom:6px;}
.us-name{font-size:14px;font-weight:700;color:var(--bright);margin-bottom:4px;}
.us-desc{font-size:11px;color:var(--muted);line-height:1.6;}

/* Start button */
.start-btn{
  width:100%;background:transparent;
  border:1px solid var(--accent);
  color:var(--accent);font-family:'Exo 2',sans-serif;
  font-size:14px;font-weight:700;letter-spacing:4px;
  padding:16px;cursor:pointer;
  text-transform:uppercase;
  transition:all 0.2s;margin-top:0;
  position:relative;overflow:hidden;
}
.start-btn::before{
  content:'';position:absolute;inset:0;
  background:var(--accent);opacity:0;transition:opacity 0.2s;
}
.start-btn:hover::before{opacity:0.07;}
.start-btn:hover{box-shadow:0 0 20px rgba(41,182,246,0.2);}
.start-btn:disabled{opacity:0.3;cursor:not-allowed;}

/* ══════════════════════════ GAME SCREEN ══════════════════════════ */
#screen-game{padding-bottom:10px;}

/* Title bar */
#g-titlebar{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 16px;
  border:1px solid var(--border);border-bottom:none;
  background:var(--panel);position:relative;overflow:hidden;
}
#g-titlebar::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);
  opacity:0.4;
}
.g-title-left{display:flex;flex-direction:column;}
.g-char-name{
  font-family:'Noto Serif JP',serif;
  font-size:14px;font-weight:700;
  color:var(--bright);letter-spacing:1px;
}
.g-char-meta{font-size:10px;color:var(--muted);letter-spacing:2px;margin-top:1px;}
.g-area-text{font-size:10px;color:var(--muted);letter-spacing:2px;text-align:right;}

/* Arena */
#arena{
  display:grid;grid-template-columns:1fr 1fr;
  border:1px solid var(--border);border-bottom:none;
  background:var(--panel);
}
.combatant{padding:16px 18px;position:relative;}
.combatant.left{border-right:1px solid var(--border);}

/* Race color accent line */
.combatant.left::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--rc,var(--accent));opacity:0.6;
}
.combatant.right::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--danger);opacity:0.4;
}

.c-role{font-size:9px;letter-spacing:4px;color:var(--muted);margin-bottom:3px;}
.c-name{
  font-family:'Noto Serif JP',serif;
  font-size:16px;font-weight:700;color:var(--bright);
  margin-bottom:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.c-title{font-size:9px;color:var(--magicule);letter-spacing:2px;margin-bottom:12px;min-height:13px;}

.stats{display:grid;grid-template-columns:1fr 1fr;gap:2px 10px;margin-bottom:10px;}
.stat{display:flex;justify-content:space-between;font-size:11px;}
.sl{color:var(--muted);}
.sv{color:var(--text);font-weight:600;}
.sv.hi{color:var(--accent);}

.bar-row{margin-bottom:7px;}
.bar-lbl{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:2px;}
.bar-track{height:4px;background:var(--border);overflow:hidden;}
.bar-fill{height:100%;transition:width 0.45s cubic-bezier(.4,0,.2,1);}
.hp-p{background:linear-gradient(90deg,#1e88e5,#29b6f6);}
.hp-e{background:linear-gradient(90deg,#c62828,#ef5350);}
.mp-f{background:linear-gradient(90deg,#6a1b9a,#ce93d8);}
.xp-f{background:linear-gradient(90deg,#e65100,var(--gold));}

.badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;min-height:18px;}
.badge{
  font-size:9px;letter-spacing:1px;padding:1px 6px;
  border:1px solid currentColor;text-transform:uppercase;
}
.badge.buff{color:var(--safe);}
.badge.debuff{color:var(--danger);}
.badge.neutral{color:var(--magicule);}

/* Skill bar */
#skill-bar{
  border:1px solid var(--border);border-bottom:none;
  background:rgba(13,21,38,0.8);
  padding:8px 16px;
  display:flex;align-items:center;gap:10px;
  flex-wrap:wrap;
}
.sb-label{font-size:9px;letter-spacing:3px;color:var(--muted);flex-shrink:0;}
.skill-chips{display:flex;gap:6px;flex-wrap:wrap;}
.sc{
  font-size:9px;letter-spacing:1px;padding:2px 8px;
  border:1px solid var(--border2);color:var(--muted);
  transition:all 0.2s;cursor:default;text-transform:uppercase;
}
.sc.unlocked{border-color:var(--magicule);color:var(--magicule);opacity:0.85;}
.sc.unlocked:hover{opacity:1;}
.sc.new-unlock{
  border-color:var(--gold);color:var(--gold);
  animation:pulse-gold 1s ease 3;
}
@keyframes pulse-gold{
  0%,100%{box-shadow:0 0 0 0 rgba(255,213,79,0);}
  50%{box-shadow:0 0 0 4px rgba(255,213,79,0.3);}
}

/* Log */
#log-area{
  border:1px solid var(--border);border-bottom:none;
  background:var(--bg);height:140px;overflow-y:auto;
  padding:8px 16px;scroll-behavior:smooth;
}
#log-area::-webkit-scrollbar{width:3px;}
#log-area::-webkit-scrollbar-thumb{background:var(--border2);}
.ll{font-size:11.5px;line-height:1.7;opacity:0;animation:lin 0.2s forwards;}
.ll.sys   {color:var(--muted);}
.ll.player{color:var(--accent);}
.ll.enemy {color:var(--danger);}
.ll.event {color:var(--gold);font-weight:700;}
.ll.pred  {color:var(--magicule);}
.ll.evolve{color:var(--spirit2);font-weight:700;}
.ll.div   {color:var(--border2);letter-spacing:3px;}
@keyframes lin{to{opacity:1;}}

/* Actions */
#actions{
  border:1px solid var(--border);border-bottom:none;
  background:var(--panel);
  padding:12px 16px;
  display:grid;grid-template-columns:repeat(3,1fr);gap:7px;
}
.ab{
  background:transparent;
  border:1px solid var(--border);
  color:var(--text);
  font-family:'Exo 2',sans-serif;
  font-size:11px;font-weight:600;letter-spacing:1px;
  padding:9px 8px 8px;cursor:pointer;
  transition:all 0.15s;text-align:left;
  text-transform:uppercase;position:relative;overflow:hidden;
}
.ab .hk{font-size:9px;color:var(--muted);display:block;margin-bottom:2px;}
.ab .ac{float:right;font-size:9px;color:var(--muted);}
.ab:hover:not(:disabled){border-color:var(--accent);color:var(--accent);}
.ab.race-skill{border-color:rgba(255,202,40,0.2);}
.ab.race-skill:hover:not(:disabled){border-color:var(--human);color:var(--human);}
.ab.demon-skill{border-color:rgba(239,83,80,0.2);}
.ab.demon-skill:hover:not(:disabled){border-color:var(--demon);color:var(--demon);}
.ab.angel-skill{border-color:rgba(179,229,252,0.2);}
.ab.angel-skill:hover:not(:disabled){border-color:var(--angel);color:var(--angel);}
.ab.path-skill{border-color:rgba(206,147,216,0.2);}
.ab.path-skill:hover:not(:disabled){border-color:var(--magicule);color:var(--magicule);}
.ab.evo-skill{border-color:rgba(255,213,79,0.25);}
.ab.evo-skill:hover:not(:disabled){border-color:var(--gold);color:var(--gold);}
.ab:disabled{opacity:0.25;cursor:not-allowed;}

/* Footer */
#g-footer{
  border:1px solid var(--border);
  background:var(--deep);
  padding:7px 16px;
  display:flex;justify-content:space-between;
  font-size:10px;color:var(--muted);letter-spacing:2px;
  position:relative;
}
#g-footer::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);
  opacity:0.2;
}

/* Evolution overlay special */
#overlay{
  display:none;position:fixed;inset:0;
  background:rgba(5,8,15,0.93);
  align-items:center;justify-content:center;z-index:50;
  backdrop-filter:blur(4px);
}
#overlay.show{display:flex;}
#obox{
  background:var(--panel);
  border:1px solid var(--border2);
  padding:36px 32px;
  max-width:460px;width:92%;
  text-align:center;position:relative;overflow:hidden;
}
#obox::before{content:'';position:absolute;top:0;left:0;width:36px;height:36px;border-top:1px solid var(--accent);border-left:1px solid var(--accent);}
#obox::after {content:'';position:absolute;bottom:0;right:0;width:36px;height:36px;border-bottom:1px solid var(--accent);border-right:1px solid var(--accent);}
#o-label{font-size:9px;letter-spacing:4px;color:var(--muted);margin-bottom:6px;}
#o-title{font-family:'Noto Serif JP',serif;font-size:22px;color:var(--bright);margin-bottom:6px;text-shadow:0 0 20px rgba(41,182,246,0.4);}
#o-sub  {font-size:11px;color:var(--magicule);letter-spacing:2px;margin-bottom:18px;}
#o-body {font-size:12px;color:var(--muted);line-height:1.9;margin-bottom:26px;white-space:pre-line;text-align:left;}
#o-btn  {
  background:transparent;border:1px solid var(--accent);
  color:var(--accent);font-family:'Exo 2',sans-serif;
  font-size:13px;font-weight:700;letter-spacing:3px;
  padding:12px 28px;cursor:pointer;transition:all 0.2s;
  text-transform:uppercase;
}
#o-btn:hover{background:rgba(41,182,246,0.08);box-shadow:0 0 16px rgba(41,182,246,0.15);}

/* Skill unlock popup */
#skill-popup{
  position:fixed;top:20px;left:50%;transform:translateX(-50%);
  background:var(--panel);border:1px solid var(--gold);
  padding:10px 20px;z-index:100;
  font-size:12px;color:var(--gold);letter-spacing:2px;
  opacity:0;transition:opacity 0.3s;pointer-events:none;
  white-space:nowrap;
}
#skill-popup.show{opacity:1;}

/* Evolution flash */
@keyframes evo-flash{
  0%  {background:rgba(255,213,79,0);}
  30% {background:rgba(255,213,79,0.08);}
  100%{background:rgba(255,213,79,0);}
}
.evo-flash{animation:evo-flash 0.8s ease;}

@keyframes shake{
  0%,100%{transform:translateX(0);}
  20%{transform:translateX(-4px);}
  40%{transform:translateX(4px);}
  60%{transform:translateX(-3px);}
  80%{transform:translateX(3px);}
}
.shake{animation:shake 0.3s ease;}
</style>
</head>
<body>

<!-- ══════════════════════════ CHARACTER CREATE ══════════════════════════ -->
<div id="screen-create" class="screen active">

  <div class="cc-header">
    <div class="cc-title">転生したらスライムだった件</div>
    <div class="cc-main-title">Reincarnation Chronicle</div>
    <div class="cc-sub">Forge your soul. Choose your race. Discover your power.</div>
  </div>

  <div class="steps">
    <div class="step-dot active" id="s1">01 · NAME</div>
    <div class="step-dot" id="s2">02 · RACE</div>
    <div class="step-dot" id="s3">03 · SKILL PATH</div>
    <div class="step-dot" id="s4">04 · AWAKEN</div>
  </div>

  <!-- STEP 1: Name -->
  <div class="cc-section" id="step1">
    <div class="cc-section-title">Your Name in This World</div>
    <div class="name-input-wrap">
      <input class="name-input" id="char-name" maxlength="20" placeholder="Enter your name…" oninput="onNameInput()"/>
    </div>
    <div class="name-hint">Your name will be known throughout Tempest and beyond.</div>
  </div>

  <!-- STEP 2: Race -->
  <div class="cc-section" id="step2" style="display:none">
    <div class="cc-section-title">Choose Your Race</div>
    <div class="race-grid" id="race-grid"></div>
  </div>

  <!-- STEP 3: Skill Path -->
  <div class="cc-section" id="step3" style="display:none">
    <div class="cc-section-title">Select Your Skill Path</div>
    <div style="font-size:10px;color:var(--muted);margin-bottom:12px;letter-spacing:1px;">
      Each race restricts certain skill paths. Your path shapes which unique skills evolve as you grow stronger.
    </div>
    <div class="path-grid" id="path-grid"></div>
  </div>

  <!-- STEP 4: Preview & Start -->
  <div class="cc-section" id="step4" style="display:none">
    <div class="cc-section-title">Soul Confirmed</div>
    <div id="char-preview"></div>
  </div>

  <button class="start-btn" id="next-btn" disabled onclick="nextStep()">SELECT NAME →</button>
</div>

<!-- ══════════════════════════ GAME ══════════════════════════ -->
<div id="screen-game" class="screen">
  <div id="g-titlebar">
    <div class="g-title-left">
      <div class="g-char-name" id="g-name">—</div>
      <div class="g-char-meta" id="g-meta">—</div>
    </div>
    <div class="g-area-text" id="g-area">—</div>
  </div>

  <div id="arena">
    <div class="combatant left" id="p-panel">
      <div class="c-role">ADVENTURER</div>
      <div class="c-name" id="p-name">—</div>
      <div class="c-title" id="p-title">—</div>
      <div class="stats">
        <div class="stat"><span class="sl">ATK</span><span class="sv" id="p-atk">—</span></div>
        <div class="stat"><span class="sl">DEF</span><span class="sv" id="p-def">—</span></div>
        <div class="stat"><span class="sl">SPD</span><span class="sv" id="p-spd">—</span></div>
        <div class="stat"><span class="sl">RNK</span><span class="sv hi" id="p-rank">—</span></div>
      </div>
      <div class="bar-row">
        <div class="bar-lbl"><span>HP</span><span id="p-hp-t">—</span></div>
        <div class="bar-track"><div class="bar-fill hp-p" id="p-hp-b" style="width:100%"></div></div>
      </div>
      <div class="bar-row">
        <div class="bar-lbl"><span>MAGICULE</span><span id="p-mp-t">—</span></div>
        <div class="bar-track"><div class="bar-fill mp-f" id="p-mp-b" style="width:100%"></div></div>
      </div>
      <div class="bar-row">
        <div class="bar-lbl"><span>EXP</span><span id="p-xp-t">—</span></div>
        <div class="bar-track"><div class="bar-fill xp-f" id="p-xp-b" style="width:0%"></div></div>
